# Copie para .env e ajuste. O .env não vai para o repositório.

PORTA=3000
NODE_ENV=desenvolvimento

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=trocai
PGUSER=postgres
PGPASSWORD=postgres
PGPOOL_MAX=10

# Assinatura do token de sessão.
# Em produção é obrigatória: sem ela a API não sobe.
JWT_SEGREDO=troque-este-valor
JWT_VALIDADE=7d

# Custo do bcrypt no cadastro.
BCRYPT_RODADAS=10
